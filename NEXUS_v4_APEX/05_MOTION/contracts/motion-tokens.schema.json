{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MotionTokens",
  "type": "object",
  "required": ["engine", "version", "durations", "easings", "principles"],
  "properties": {
    "engine": { "type": "string", "const": "05_MOTION" },
    "version": { "type": "string" },
    "durations": {
      "type": "object",
      "required": ["instant", "fast", "normal", "slow"],
      "properties": {
        "instant": { "type": "string" },
        "fast": { "type": "string" },
        "normal": { "type": "string" },
        "slow": { "type": "string" }
      },
      "additionalProperties": false
    },
    "easings": {
      "type": "object",
      "required": ["standard", "enter", "exit"],
      "properties": {
        "standard": { "type": "string" },
        "enter": { "type": "string" },
        "exit": { "type": "string" }
      },
      "additionalProperties": false
    },
    "principles": { "type": "array", "items": { "type": "string" }, "minItems": 4 }
  },
  "additionalProperties": false
}

