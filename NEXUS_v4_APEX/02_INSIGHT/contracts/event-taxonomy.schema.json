{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventTaxonomy",
  "type": "object",
  "required": ["engine", "version", "requiredProperties", "events"],
  "properties": {
    "engine": { "type": "string", "const": "02_INSIGHT" },
    "version": { "type": "string" },
    "requiredProperties": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 3
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "properties"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z]+_[a-z0-9_]+$" },
          "properties": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

