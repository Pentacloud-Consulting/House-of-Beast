{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CROChecklist",
  "type": "object",
  "required": ["engine", "version", "aboveTheFold", "ctaRules"],
  "properties": {
    "engine": { "type": "string", "const": "02_INSIGHT" },
