{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StructuredDataPlan",
  "type": "object",
  "required": ["engine", "version", "pageTypes"],
  "properties": {
    "engine": { "type": "string", "const": "21_SEO" },
    "version": { "type": "string" },
    "pageTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "schemas"],
        "properties": {
          "type": { "type": "string" },
          "schemas": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        },
        "additionalProperties": false
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}

