{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SitemapsPlan",
  "type": "object",
  "required": ["engine", "version", "index", "sitemaps", "submission"],
  "properties": {
    "engine": { "type": "string", "const": "21_SEO" },
    "version": { "type": "string" },
    "index": { "type": "string", "description": "Path to sitemap index (e.g. /sitemap.xml)" },
    "sitemaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "kind"],
        "properties": {
          "path": { "type": "string" },
          "kind": { "type": "string", "enum": ["pages", "blog", "products", "images", "video", "other"] }
        },
        "additionalProperties": false
      }
    },
    "submission": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  },
  "additionalProperties": false
}

