{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GradientRules",
  "type": "object",
  "required": ["engine", "version", "rules"],
  "properties": {
    "engine": { "type": "string", "const": "03_PALETTE" },
    "version": { "type": "string" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rule", "why"],
        "properties": {
          "id": { "type": "string" },
          "rule": { "type": "string" },
          "why": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

