{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ColorTokens",
  "type": "object",
  "required": ["space", "tokens"],
  "properties": {
    "space": { "type": "string", "enum": ["OKLCH", "LCH", "LAB"] },
    "tokens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" },
          "role": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

